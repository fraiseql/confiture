{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.dev/schemas/build.schema.json",
  "title": "confiture build --format json",
  "description": "The result of `confiture build --format json`: what was assembled from the DDL tree and where it went. Payload = BuildResult.to_dict().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "files_processed",
    "schema_size_bytes",
    "output_path",
    "hash",
    "execution_time_ms",
    "seed_files_applied",
    "warnings",
    "error",
    "duplicates"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "files_processed": {
      "type": "integer",
      "minimum": 0
    },
    "schema_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "output_path": {
      "type": "string"
    },
    "hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "seed_files_applied": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0).",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    },
    "duplicates": {
      "type": "array",
      "description": "Objects defined more than once across the build's files (build_001) and routine overload families split across files (build_002); populated by --warn-duplicates / --fail-on-duplicates, empty otherwise.",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "kind",
          "identity",
          "definitions",
          "wins"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": [
              "build_001",
              "build_002"
            ]
          },
          "kind": {
            "type": "string"
          },
          "identity": {
            "type": "string",
            "description": "schema.name(signature) as written by the first definition."
          },
          "definitions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "file",
                "offset",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "wins": {
            "type": "string",
            "enum": [
              "last",
              "first",
              "conflict",
              "n/a"
            ]
          }
        }
      }
    }
  }
}
