{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.dev/schemas/build.schema.json",
  "title": "confiture build --format json",
  "description": "The result of `confiture build --format json`: what was assembled from the DDL tree and where it went. Payload = BuildResult.to_dict().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "files_processed",
    "schema_size_bytes",
    "output_path",
    "hash",
    "execution_time_ms",
    "seed_files_applied",
    "warnings",
    "error",
    "duplicates"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "files_processed": {
      "type": "integer",
      "minimum": 0
    },
    "schema_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "output_path": {
      "type": "string"
    },
    "hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "seed_files_applied": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "description": "Build-time diagnostics: what the build has to say that is not a failure — a seed file that failed under --continue-on-error, a file the duplicate scan could not parse. Empty on a build with nothing to report. Before 1.6.0 this array was published and never written to, and its entries were typed as plain strings (#268). Defined inline rather than in _common.schema.json because this schema's $id is on a different host, which a relative $ref out of it cannot resolve.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "file"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The error-code registry entry that names the situation (e.g. `SEED_002`), so a consumer matches a code rather than a sentence."
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "info"
            ],
            "description": "The severity the registry publishes for `code`; never `error` here — an error is not a warning, it is the envelope's `error` field."
          },
          "message": {
            "type": "string",
            "description": "What happened, in one line."
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "description": "The file it is about, relative to the project root; null when the warning is about the build rather than one file."
          }
        }
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0).",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    },
    "duplicates": {
      "type": "array",
      "description": "Objects defined more than once across the build's files (build_001) and routine overload families split across files (build_002); populated by --warn-duplicates / --fail-on-duplicates, empty otherwise.",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "kind",
          "identity",
          "definitions",
          "wins"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": [
              "build_001",
              "build_002"
            ]
          },
          "kind": {
            "type": "string"
          },
          "identity": {
            "type": "string",
            "description": "schema.name(signature) as written by the first definition."
          },
          "definitions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "file",
                "offset",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "wins": {
            "type": "string",
            "enum": [
              "last",
              "first",
              "conflict",
              "n/a"
            ]
          }
        }
      }
    }
  }
}
