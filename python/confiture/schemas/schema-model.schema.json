{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.dev/schemas/schema-model.schema.json",
  "title": "SchemaModel.to_json()",
  "description": "The one model of what a schema declares, as `confiture.platform` writes it: `SchemaModel.to_json()`, read back by `SchemaModel.from_json()`. Objects are listed in identity order ((schema, name) with an unqualified name in the default schema); a routine appears once per overload. Not a command payload on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tables",
    "enum_types",
    "sequences",
    "routines",
    "views",
    "triggers",
    "tviews",
    "other_objects",
    "coverage",
    "source"
  ],
  "properties": {
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Table"
      }
    },
    "enum_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnumType"
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sequence"
      }
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Routine"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/View"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Trigger"
      }
    },
    "tviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TView"
      }
    },
    "other_objects": {
      "type": "array",
      "description": "Every object of the kinds no typed section holds (a schema, an extension, a domain, a composite or range type, a policy, a rule, …), by identity and definition; `definition` is null from a reader that read only that the object exists.",
      "items": {
        "$ref": "#/$defs/OtherObject"
      }
    },
    "coverage": {
      "type": "object",
      "description": "What the reader read: each section of the model it covers, and how deeply (`existence` or `definition`). A section absent here was not read, so its silence is not absence. A tree covers every section; a live read, the sections it was asked for. Not part of what the schema is.",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "enum_types": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "sequences": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "routines": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "views": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "triggers": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "tviews": {
          "enum": [
            "existence",
            "definition"
          ]
        },
        "other_objects": {
          "enum": [
            "existence",
            "definition"
          ]
        }
      }
    },
    "source": {
      "enum": [
        "author",
        "catalog"
      ],
      "description": "Who wrote what the model says: an author's DDL (`author`) or PostgreSQL's catalog (`catalog`). A comparison of two models follows from the two sides' sources: two trees are compared as written, a tree and a database through the parity rules, two catalogs exactly. Not part of what the schema is."
    }
  },
  "$defs": {
    "RelationName": {
      "type": "object",
      "description": "A relation one object names — a foreign key's target, an index's table — as its two parts, never one dotted string: a quoted name may hold a dot (`app.\"a.b\"`). `schema` is null where the schema file wrote none.",
      "additionalProperties": false,
      "required": [
        "schema",
        "name"
      ],
      "properties": {
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Column": {
      "type": "object",
      "description": "A column, whole. `type_key` is the identity (typmod kept), `raw_sql_type` the spelling generated DDL writes, `type_text` the author's.",
      "additionalProperties": false,
      "required": [
        "name",
        "folded",
        "line",
        "type_text",
        "type_key",
        "raw_sql_type",
        "not_null",
        "not_null_validated",
        "default",
        "identity",
        "generated",
        "generated_kind",
        "primary_key",
        "file",
        "default_kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "folded": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "type_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_sql_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "not_null": {
          "type": "boolean"
        },
        "not_null_validated": {
          "type": "boolean",
          "description": "False for a NOT NULL PostgreSQL 18 holds NOT VALID: rows from before it may be NULL. True for every other column."
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "enum": [
            "always",
            "by default",
            null
          ]
        },
        "generated": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_kind": {
          "enum": [
            "stored",
            "virtual",
            null
          ]
        },
        "primary_key": {
          "type": "boolean"
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "The file that wrote the column — another than its table's when an `ALTER TABLE … ADD COLUMN` in a later file added it — named relative to the project; null for DDL handed in as text. Where a column is written is not what it is: two models differing only here are one schema."
        },
        "default_kind": {
          "enum": [
            "sequence",
            "generator",
            "constant",
            "expression",
            null
          ],
          "description": "What `default` is, read from its parse tree: a `nextval(…)`, a call to a value generator (`gen_random_uuid()`, `uuidv7()`, …), a constant, or another expression; null for no default. With `identity`, `generated` and a `serial` `raw_sql_type`, it decides `Column.value_source`."
        }
      }
    },
    "Constraint": {
      "type": "object",
      "description": "A primary key, a UNIQUE, a CHECK, a foreign key or an EXCLUDE. `name` is empty where the schema wrote none; an empty `ref_columns` means the referenced primary key. An EXCLUDE's `columns` are its elements, with `operators` and `key_options` alongside.",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "columns",
        "ref_table",
        "ref_columns",
        "on_delete",
        "on_update",
        "expression",
        "deferrable",
        "operators",
        "method",
        "where",
        "key_options",
        "nulls_not_distinct",
        "temporal",
        "enforced"
      ],
      "properties": {
        "kind": {
          "enum": [
            "primary_key",
            "unique",
            "check",
            "foreign_key",
            "exclusion"
          ]
        },
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ref_table": {
          "oneOf": [
            {
              "$ref": "#/$defs/RelationName"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_delete": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_update": {
          "type": [
            "string",
            "null"
          ]
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "deferrable": {
          "enum": [
            "immediate",
            "deferred",
            null
          ]
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "where": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nulls_not_distinct": {
          "type": "boolean",
          "description": "A UNIQUE's `NULLS NOT DISTINCT`: two rows holding NULL in a key column collide. False for every other kind."
        },
        "temporal": {
          "type": "boolean",
          "description": "A PRIMARY KEY or UNIQUE whose last key is `WITHOUT OVERLAPS`, or a foreign key whose last column pair is `PERIOD` (PostgreSQL 18): an exclusion over a period, not a btree uniqueness."
        },
        "enforced": {
          "type": "boolean",
          "description": "False for a CHECK or foreign key declared `NOT ENFORCED` (PostgreSQL 18). True for every other constraint."
        }
      }
    },
    "Index": {
      "type": "object",
      "description": "An index on one table or materialized view. `backs_constraint` marks PostgreSQL's own index behind a PRIMARY KEY, UNIQUE or EXCLUDE.",
      "additionalProperties": false,
      "required": [
        "name",
        "table",
        "columns",
        "unique",
        "where",
        "method",
        "backs_constraint",
        "key_options",
        "expressions",
        "nulls_not_distinct"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "$ref": "#/$defs/RelationName"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unique": {
          "type": "boolean"
        },
        "where": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "backs_constraint": {
          "type": "boolean"
        },
        "key_options": {
          "type": "array",
          "description": "Alongside `columns`: what each key's element writes after the key (collation, operator class, ordering), `\"\"` for a key that writes none; empty when no key writes any.",
          "items": {
            "type": "string"
          }
        },
        "expressions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "boolean"
          },
          "description": "Alongside `columns`: whether each key is an expression rather than a column; null where the reader recorded nothing."
        },
        "nulls_not_distinct": {
          "type": "boolean",
          "description": "The index's `NULLS NOT DISTINCT` (`pg_index.indnullsnotdistinct`), recorded on any index, constraining only a unique one."
        }
      }
    },
    "Table": {
      "type": "object",
      "description": "A table: its columns, its constraints and its indexes. `schema` is null where the author wrote none.",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "columns",
        "constraints",
        "indexes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Index"
          }
        }
      }
    },
    "EnumType": {
      "type": "object",
      "description": "`CREATE TYPE … AS ENUM`: its labels, in declaration order.",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Sequence": {
      "type": "object",
      "description": "`CREATE SEQUENCE`, with the options a comparison reads.",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "start",
        "increment",
        "min_value",
        "max_value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": [
            "integer",
            "null"
          ]
        },
        "increment": {
          "type": [
            "integer",
            "null"
          ]
        },
        "min_value": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_value": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "Routine": {
      "type": "object",
      "description": "One overload of a function, procedure or aggregate. `signature` is the spelling, `signature_key` the identity: (schema or null, canonical type) per input argument.",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "kind",
        "signature",
        "signature_key",
        "returns",
        "language",
        "body",
        "security_definer",
        "search_path_pinned",
        "volatility"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "function",
            "procedure",
            "aggregate"
          ]
        },
        "signature": {
          "type": "string"
        },
        "signature_key": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "returns": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "security_definer": {
          "type": "boolean"
        },
        "search_path_pinned": {
          "type": "boolean"
        },
        "volatility": {
          "enum": [
            "immutable",
            "stable",
            "volatile"
          ]
        }
      }
    },
    "View": {
      "type": "object",
      "description": "A view or a materialized view; `definition` is the query as the reader holds it.",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "materialized",
        "definition",
        "indexes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "materialized": {
          "type": "boolean"
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Index"
          }
        }
      }
    },
    "Trigger": {
      "type": "object",
      "description": "A trigger a user created, named with the table it fires on.",
      "additionalProperties": false,
      "required": [
        "name",
        "table",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TView": {
      "type": "object",
      "description": "A pg_tviews TVIEW: `CREATE TABLE tv_<entity> AS SELECT …`, held as one object whose table, backing view (in pg_tviews' `tviews` schema, named by `tviews.registry.view`) and triggers belong to it. `definition` is the query as the reader holds it. `logged` and `fillfactor` are pg_tviews' `options` keys of those names, and `uncascaded_policy` (`warn`, `error` or `full_refresh`) what a write to a table no cascade reaches does: what a tree pins, `null` where it pins nothing, or what `tviews.registry` holds, every key set. `time_refresh` (`external`) and `function_reads` are what the TVIEW declares of the reads no write to a tracked table changes: the time, and the tables a non-immutable function reads (pg_tviews 0.1.0-beta.26). A tree pins them in a `pg_tviews_create_or_replace()` call's `options` alone; `function_reads` `[]` pins none. `uncascaded_tables` is each table's own `uncascaded_policy`, overriding the TVIEW's for a write to that table (pg_tviews 0.1.0-beta.26, the `uncascaded_tables` option, `tviews.registry.uncascaded_table_policies`): pinned the same way, `[]` pinning none. `SchemaModel.from_json()` reads a model written before TVIEWs were modelled, which has no `tviews` key, as holding none. A TVIEW written before an option was modelled lacks its key and pins nothing.",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "definition",
        "logged",
        "fillfactor",
        "uncascaded_policy",
        "time_refresh",
        "function_reads",
        "uncascaded_tables"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "logged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fillfactor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "uncascaded_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_refresh": {
          "type": [
            "string",
            "null"
          ]
        },
        "function_reads": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/FunctionRead"
          }
        },
        "uncascaded_tables": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/UncascadedTable"
          }
        }
      }
    },
    "UncascadedTable": {
      "type": "object",
      "description": "What a write to one table no cascade reaches does to a TVIEW: one entry of pg_tviews' `uncascaded_tables` option. `table` is a spelling, the author's or the registry's (`regclass` text, bare on the read path); `policy` (`warn`, `error` or `full_refresh`) overrides the TVIEW's `uncascaded_policy` for it. Entries are sorted by `table`.",
      "additionalProperties": false,
      "required": [
        "table",
        "policy"
      ],
      "properties": {
        "table": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "FunctionRead": {
      "type": "object",
      "description": "A function a TVIEW's definition calls and the tables it reads: one entry of pg_tviews' `function_reads`. `function` is keyed as pg_tviews keys it, with its argument types (`public.label_suffix()`); `tables` are the tables it reads, `[]` for none. Both are spellings, the author's or the registry's; entries are sorted by `function`, tables sorted.",
      "additionalProperties": false,
      "required": [
        "function",
        "tables"
      ],
      "properties": {
        "function": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OtherObject": {
      "type": "object",
      "description": "An object the model holds by identity and definition only. `schema` is folded and defaulted; a policy or rule is named `table.name`.",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "name",
        "definition"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
