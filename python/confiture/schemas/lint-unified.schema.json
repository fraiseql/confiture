{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.fraiseql.dev/schemas/lint-unified.schema.json",
  "title": "confiture lint-unified --format json",
  "description": "Squawk, SQLFluff, the schema linter and the tree rules in one report. A check that was asked for and could not run — its tool missing, or failing — is under `skipped`, never read as a clean result (#358).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "issues",
    "skipped"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "errors",
        "warnings",
        "info"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "file",
          "line",
          "message",
          "severity",
          "rule"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "description": "`squawk`, `sqlfluff`, `schema` or `tree`."
          },
          "file": {
            "type": "string",
            "description": "The file the finding is in, as the tool named it."
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "description": "1-based; null when the tool gives none."
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "rule": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "description": "Each check that did not run, and why (1.22.0).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "tool",
          "reason"
        ],
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "safety",
              "format",
              "schema",
              "tree"
            ]
          },
          "tool": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "The envelope (1.16.0): the command produced this report. What the report found is in its own fields; a command that could not produce one writes the error envelope, where ok is false."
    },
    "command": {
      "type": "string",
      "description": "The envelope (1.16.0): the command that wrote this payload, as typed after `confiture` (`migrate up`, `lint`)."
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0).",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    }
  }
}
