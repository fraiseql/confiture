{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.fraiseql.dev/schemas/migrate-validate-check-acl-coverage.schema.json",
  "title": "confiture migrate validate --check-acls --format json",
  "description": "Static ACL coverage report: every `CREATE TABLE` in db/migrations/ must have a matching `GRANT` in the same migration or in the configured grant-sweep directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check",
    "violations",
    "hints"
  ],
  "properties": {
    "check": {
      "type": "string",
      "const": "acl_coverage"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "severity",
          "object_name",
          "message",
          "file_path"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "object_name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "file_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "hints": {
      "$ref": "_common.schema.json#/$defs/HintsArray"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0): the installed pglast release and the PostgreSQL grammar major it embeds.",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    },
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "The envelope (1.16.0): the command produced this report. What the report found is in its own fields; a command that could not produce one writes the error envelope, where ok is false."
    },
    "command": {
      "type": "string",
      "description": "The envelope (1.16.0): the command that wrote this payload, as typed after `confiture` (`migrate up`, `lint`)."
    }
  }
}
