{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.dev/schemas/sync.schema.json",
  "title": "confiture sync --format json",
  "description": "The result of `confiture sync --format json`: rows copied per table. Payload = SyncResult.to_dict().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "command",
    "anonymized",
    "tables",
    "total_rows",
    "warnings"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "command": {
      "type": "string",
      "const": "sync"
    },
    "anonymized": {
      "type": "boolean"
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "total_rows": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0).",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    }
  }
}
