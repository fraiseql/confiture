{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.dev/schemas/lint.schema.json",
  "title": "confiture lint --format json",
  "description": "The result of `confiture lint --format json`: the violations the enabled rules found. Payload = LintReport.to_dict().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "tables_checked",
    "columns_checked",
    "execution_time_ms",
    "violations",
    "skipped",
    "degraded"
  ],
  "properties": {
    "schema_name": {
      "type": "string"
    },
    "tables_checked": {
      "type": "integer",
      "minimum": 0
    },
    "columns_checked": {
      "type": "integer",
      "minimum": 0
    },
    "execution_time_ms": {
      "type": [
        "integer",
        "number"
      ],
      "minimum": 0
    },
    "violations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "errors",
        "warnings",
        "info",
        "items"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "info": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "rule_id",
              "severity",
              "location",
              "file",
              "line",
              "message",
              "suggested_fix"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "location": {
                "type": "string"
              },
              "file": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Source file the finding is in, relative to the project root; null when the rule read a string rather than a file tree."
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "1-based line within `file`; null whenever `file` is null."
              },
              "message": {
                "type": "string"
              },
              "suggested_fix": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0).",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    },
    "baseline": {
      "type": "object",
      "description": "Present only when --baseline was given: findings not in the baseline (new), baseline identities no longer found (fixed, removed from the file), and how many current findings the file already knew (known). violations.items then lists the new findings only.",
      "required": [
        "new",
        "fixed",
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "reachable",
        "reason",
        "max_selectable_severity"
      ],
      "description": "What decided the exit code, and whether anything the run selected could have reached it (#247). Present on every `confiture lint` payload.",
      "properties": {
        "threshold": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "never"
          ],
          "description": "The severity at or above which a finding fails the run \u2014 `--fail-on`."
        },
        "reachable": {
          "type": "boolean",
          "description": "Whether any selected rule can emit at or above `threshold`, escalations applied."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the threshold cannot be reached, in the words the summary line uses; null when it can."
        },
        "max_selectable_severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "error",
            "warning",
            "info",
            null
          ],
          "description": "The most severe finding this selection can produce; null when no rule is selected."
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "state",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The rule code this is about."
          },
          "state": {
            "type": "string",
            "enum": [
              "skipped",
              "degraded"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Why, in the words the summary line uses."
          }
        }
      },
      "description": "Rules that did not run at all, each with a reason. Always present, empty when none. A skip is never a pass: `--fail-on` cannot be satisfied by a rule that did not run."
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "state",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The rule code this is about."
          },
          "state": {
            "type": "string",
            "enum": [
              "skipped",
              "degraded"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Why, in the words the summary line uses."
          }
        }
      },
      "description": "Rules that ran without one of the things they resolve against, so they can over-report. `build_003` with no reachable database is the first of them: an object created by a migration or owned by an extension is then reported as missing."
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documented",
        "undocumented",
        "comment_length",
        "rules"
      ],
      "description": "What the `doc` family measured, present only when it ran (#250). The rules report that a COMMENT exists; a project driving that counter to zero is rewarded by whatever satisfies it, so 100% documented reads the same for a hundred paragraphs and a hundred one-line restatements. The top-level figures are the family's; `rules` carries one row per doc code, always all four, so a code with no objects in the schema is a row of zeros rather than an absence.",
      "properties": {
        "documented": {
          "type": "integer",
          "minimum": 0,
          "description": "Objects in scope of a doc rule that carry a non-blank COMMENT."
        },
        "undocumented": {
          "type": "integer",
          "minimum": 0,
          "description": "Objects in scope of a doc rule that carry none. A COMMENT ... IS NULL removes a comment and counts here, as does an empty one."
        },
        "comment_length": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "p10",
            "p50",
            "p90"
          ],
          "description": "Comment-length percentiles over the documented objects, nearest-rank, so each value is a length some comment actually has. Lengths are the comment text with surrounding whitespace stripped. Null when nothing in scope carries a comment.",
          "properties": {
            "p10": {
              "type": "integer",
              "minimum": 0
            },
            "p50": {
              "type": "integer",
              "minimum": 0
            },
            "p90": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rules": {
          "type": "array",
          "description": "One row per doc rule, in catalogue order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "documented",
              "undocumented",
              "comment_length"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "documented": {
                "type": "integer",
                "minimum": 0
              },
              "undocumented": {
                "type": "integer",
                "minimum": 0
              },
              "comment_length": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "p10",
                  "p50",
                  "p90"
                ],
                "description": "Comment-length percentiles over the documented objects, nearest-rank, so each value is a length some comment actually has. Lengths are the comment text with surrounding whitespace stripped. Null when nothing in scope carries a comment.",
                "properties": {
                  "p10": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "p50": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "p90": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
