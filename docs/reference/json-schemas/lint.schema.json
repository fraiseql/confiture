{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confiture.dev/schemas/lint.schema.json",
  "title": "confiture lint --format json",
  "description": "The result of `confiture lint --format json`: the violations the enabled rules found. Payload = LintReport.to_dict().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "tables_checked",
    "columns_checked",
    "execution_time_ms",
    "violations"
  ],
  "properties": {
    "schema_name": {
      "type": "string"
    },
    "tables_checked": {
      "type": "integer",
      "minimum": 0
    },
    "columns_checked": {
      "type": "integer",
      "minimum": 0
    },
    "execution_time_ms": {
      "type": [
        "integer",
        "number"
      ],
      "minimum": 0
    },
    "violations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "errors",
        "warnings",
        "info",
        "items"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "info": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "rule_id",
              "severity",
              "location",
              "message",
              "suggested_fix"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "location": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "suggested_fix": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pglast",
        "pg_major"
      ],
      "description": "What parsed the SQL behind this payload (0.50.0).",
      "properties": {
        "pglast": {
          "type": "string"
        },
        "pg_major": {
          "type": "integer"
        }
      }
    },
    "baseline": {
      "type": "object",
      "description": "Present only when --baseline was given: findings not in the baseline (new), baseline identities no longer found (fixed, removed from the file), and how many current findings the file already knew (known). violations.items then lists the new findings only.",
      "required": [
        "new",
        "fixed",
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
