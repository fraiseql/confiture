        "has_seed": false
      },
      {
        "column": "cvv",
        "strategy": "redact",
        "has_seed": false
      }
    ]
  },
  "ok": true,
  "command": "validate-profile",
  "parser": {
    "pglast": "8.4",
    "pg_major": 18
  }
}
