      {
        "type": "ADD_VIEW",
        "table": "app.v_order",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE VIEW app.v_order AS SELECT o.tenant_id, o.id, o.reference, o.created_at, p.id AS provider_id, c.legal_name AS provider_name FROM app.tb_order AS o INNER JOIN app.tb_provider AS p ON p.tenant_id = o.tenant_id AND p.id = o.fk_provider INNER JOIN catalog.tb_company AS c ON c.id = p.fk_company",
        "details": {
          "kind": "view",
          "name": "app.v_order",
          "keyword": "VIEW"
        }
      },
      {
        "type": "ADD_VIEW",
        "table": "app.v_unit",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE VIEW app.v_unit AS SELECT o.id AS tenant_id, u.id, u.code, u.label, FALSE AS is_custom FROM catalog.tb_unit AS u CROSS JOIN management.tb_organization AS o UNION ALL SELECT c.tenant_id, c.id, c.code, c.label, TRUE FROM app.tb_custom_unit AS c",
        "details": {
          "kind": "view",
          "name": "app.v_unit",
          "keyword": "VIEW"
        }
