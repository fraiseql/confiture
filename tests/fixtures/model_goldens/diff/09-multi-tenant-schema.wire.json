      {
        "type": "ADD_FUNCTION",
        "table": "app.fn_create_order(uuid, uuid, text)",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE FUNCTION app.fn_create_order(p_tenant_id uuid, p_provider uuid, p_reference text) RETURNS uuid LANGUAGE plpgsql AS $$\nDECLARE\n    v_id uuid := gen_random_uuid();\nBEGIN\n    INSERT INTO app.tb_order (tenant_id, id, fk_provider, reference)\n    VALUES (p_tenant_id, v_id, p_provider, p_reference);\n    RETURN v_id;\nEND;\n$$",
        "details": {
          "kind": "function",
          "name": "app.fn_create_order(uuid, uuid, text)",
          "keyword": "FUNCTION"
        }
