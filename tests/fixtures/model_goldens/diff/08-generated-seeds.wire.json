      {
        "type": "ADD_FUNCTION",
        "table": "fn_resolve_tb_product()",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE FUNCTION fn_resolve_tb_product() RETURNS void AS $$\nBEGIN\n    INSERT INTO catalog.tb_product (id, fk_vendor, name, price, status)\n    SELECT prep.id, vendor.pk_vendor, prep.name, prep.price, prep.status\n    FROM prep_seed.tb_product prep\n    LEFT JOIN catalog.tb_vendor vendor ON vendor.id = prep.fk_vendor_id\n    ON CONFLICT (id) DO NOTHING;\nEND;\n$$ LANGUAGE plpgsql",
        "details": {
          "kind": "function",
          "name": "fn_resolve_tb_product()",
          "keyword": "FUNCTION"
        }
      },
