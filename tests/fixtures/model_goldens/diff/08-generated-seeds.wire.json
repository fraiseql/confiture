        "type": "ADD_FUNCTION",
        "table": "fn_resolve_tb_vendor()",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE FUNCTION fn_resolve_tb_vendor() RETURNS void AS $$\nBEGIN\n    INSERT INTO catalog.tb_vendor (id, name, country_code)\n    SELECT prep.id, prep.name, prep.country_code\n    FROM prep_seed.tb_vendor prep\n    ON CONFLICT (id) DO NOTHING;\nEND;\n$$ LANGUAGE plpgsql",
        "details": {
          "kind": "function",
          "name": "fn_resolve_tb_vendor()",
