      {
        "type": "ADD_FUNCTION",
        "table": "public.prevent_delete_project_with_tasks()",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE FUNCTION public.prevent_delete_project_with_tasks() RETURNS trigger AS $$\nBEGIN\n    IF EXISTS (\n        SELECT 1 FROM tasks\n        WHERE project_id = OLD.id\n        AND status NOT IN ('done', 'cancelled')\n    ) THEN\n        RAISE EXCEPTION 'Cannot delete project with active tasks. Complete or cancel tasks first.';\n    END IF;\n    RETURN OLD;\nEND;\n$$ LANGUAGE plpgsql",
        "details": {
          "kind": "function",
          "name": "public.prevent_delete_project_with_tasks()",
          "keyword": "FUNCTION"
        }
      },
      {
        "type": "ADD_FUNCTION",
        "table": "public.set_task_completed_at()",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE FUNCTION public.set_task_completed_at() RETURNS trigger AS $$\nBEGIN\n    IF NEW.status = 'done' AND OLD.status != 'done' THEN\n        NEW.completed_at = NOW();\n    ELSIF NEW.status != 'done' AND OLD.status = 'done' THEN\n        NEW.completed_at = NULL;\n    END IF;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql",
        "details": {
          "kind": "function",
          "name": "public.set_task_completed_at()",
          "keyword": "FUNCTION"
        }
      },
      {
        "type": "ADD_FUNCTION",
        "table": "public.update_updated_at_column()",
        "column": null,
        "old_value": null,
        "new_value": "CREATE OR REPLACE FUNCTION public.update_updated_at_column() RETURNS trigger AS $$\nBEGIN\n    NEW.updated_at = NOW();\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql",
        "details": {
          "kind": "function",
          "name": "public.update_updated_at_column()",
          "keyword": "FUNCTION"
        }
