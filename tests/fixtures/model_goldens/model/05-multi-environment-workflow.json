{
  "enum_types": [],
  "routines": [
    {
      "body": "\nBEGIN\n    IF EXISTS (\n        SELECT 1 FROM tasks\n        WHERE project_id = OLD.id\n        AND status NOT IN ('done', 'cancelled')\n    ) THEN\n        RAISE EXCEPTION 'Cannot delete project with active tasks. Complete or cancel tasks first.';\n    END IF;\n    RETURN OLD;\nEND;\n",
      "kind": "function",
      "language": "plpgsql",
      "name": "prevent_delete_project_with_tasks",
      "returns": "trigger",
      "schema": "public",
      "search_path_pinned": false,
      "security_definer": false,
      "signature": "",
      "signature_key": [],
      "volatility": "volatile"
    },
    {
      "body": "\nBEGIN\n    IF NEW.status = 'done' AND OLD.status != 'done' THEN\n        NEW.completed_at = NOW();\n    ELSIF NEW.status != 'done' AND OLD.status = 'done' THEN\n        NEW.completed_at = NULL;\n    END IF;\n    RETURN NEW;\nEND;\n",
      "kind": "function",
      "language": "plpgsql",
      "name": "set_task_completed_at",
      "returns": "trigger",
      "schema": "public",
      "search_path_pinned": false,
      "security_definer": false,
      "signature": "",
      "signature_key": [],
      "volatility": "volatile"
    },
    {
      "body": "\nBEGIN\n    NEW.updated_at = NOW();\n    RETURN NEW;\nEND;\n",
