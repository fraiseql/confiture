  "routines": [
    {
      "body": "\nBEGIN\n    INSERT INTO catalog.tb_product (id, fk_vendor, name, price, status)\n    SELECT prep.id, vendor.pk_vendor, prep.name, prep.price, prep.status\n    FROM prep_seed.tb_product prep\n    LEFT JOIN catalog.tb_vendor vendor ON vendor.id = prep.fk_vendor_id\n    ON CONFLICT (id) DO NOTHING;\nEND;\n",
      "kind": "function",
      "language": "plpgsql",
      "name": "fn_resolve_tb_product",
      "returns": "void",
      "schema": null,
      "search_path_pinned": false,
      "security_definer": false,
      "signature": "",
      "signature_key": [],
      "volatility": "volatile"
    },
    {
      "body": "\nBEGIN\n    INSERT INTO catalog.tb_vendor (id, name, country_code)\n    SELECT prep.id, prep.name, prep.country_code\n    FROM prep_seed.tb_vendor prep\n    ON CONFLICT (id) DO NOTHING;\nEND;\n",
      "kind": "function",
      "language": "plpgsql",
      "name": "fn_resolve_tb_vendor",
