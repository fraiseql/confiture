  "routines": [
    {
      "body": "\nBEGIN\n    INSERT INTO catalog.tb_product (id, fk_vendor, name, price, status)\n    SELECT prep.id, vendor.pk_vendor, prep.name, prep.price, prep.status\n    FROM prep_seed.tb_product prep\n    LEFT JOIN catalog.tb_vendor vendor ON vendor.id = prep.fk_vendor_id\n    ON CONFLICT (id) DO NOTHING;\nEND;\n",
      "kind": "function",
      "language": "plpgsql",
      "name": "fn_resolve_tb_product",
      "returns": "void",
      "schema": null,
      "search_path_pinned": false,
