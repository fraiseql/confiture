      "signature": "",
      "signature_key": [],
      "volatility": "volatile"
    },
    {
      "body": "\nBEGIN\n    INSERT INTO catalog.tb_vendor (id, name, country_code)\n    SELECT prep.id, prep.name, prep.country_code\n    FROM prep_seed.tb_vendor prep\n    ON CONFLICT (id) DO NOTHING;\nEND;\n",
